HELPDESK_APP_NAME="Helpdesk API"
HELPDESK_APP_VERSION="0.1.0"
HELPDESK_ENVIRONMENT="development"
HELPDESK_DEBUG=false
HELPDESK_API_V1_PREFIX="/api/v1"
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk_password
POSTGRES_DB=helpdesk
HELPDESK_DATABASE_URL="postgresql+asyncpg://helpdesk:helpdesk_password@localhost:5433/helpdesk"
HELPDESK_JWT_SECRET_KEY=replace-with-a-secure-random-value
HELPDESK_JWT_ALGORITHM=HS256
HELPDESK_ACCESS_TOKEN_EXPIRE_MINUTES=30
